#!/bin/sh
# ============================================================================
# VolManAudioQueue Full 2.0.2 安装后脚本（全量包）
#
# 本包自带全套组件，因此不需要「停用原版再补丁」这一套：
#   自带 → Library/MobileSubstrate/DynamicLibraries/VolumeManager.dylib        (原版·主模块)
#   自带 → Library/MobileSubstrate/DynamicLibraries/VolumeManagerSBHUD.dylib   (原版·音量 HUD)
#   自带 → Library/PreferenceBundles/VolumeManagerPrefs.bundle                 (原版·设置面板)
#   自带 → Library/MobileSubstrate/DynamicLibraries/VolManAudioQueue.dylib     (重写·每 App 音量引擎)
#
# 唯一不包含的是原版 VolumeManagerAudioQueue.dylib —— 杂音就是它造成的。
# 所以这里要做的是「确保它不在加载路径里」，把它挪到数据目录留档即可。
# （从旧版本升级过来时，旧 postrm 可能刚把它还原回来，这一步是必需的。）
# ============================================================================

JB=/var/jb
DL="$JB/Library/MobileSubstrate/DynamicLibraries"

DIR_JB=/var/jb/var/mobile/Library/VolumeManager-sunshinesong
DIR_PLAIN=/var/mobile/Library/VolumeManager-sunshinesong
DIR_JBROOT=/.jbroot/var/mobile/Library/VolumeManager-sunshinesong
SYNCED=/var/mobile/Library/Preferences/com.local.volmanaudioqueue.appvolume.plist
GRAVEYARD="$DIR_JB/original-noisy-module-backup"

echo "VolManAudioQueue Full: 检查加载路径…"
mkdir -p "$DIR_JB" "$GRAVEYARD" 2>/dev/null
chmod 777 "$DIR_JB" 2>/dev/null

# 把任何形态的「原版有杂音模块」移出加载路径（.dylib / .plist / .vmaq-backup / .vmaq-off）
for f in "$DL/VolumeManagerAudioQueue.dylib" \
         "$DL/VolumeManagerAudioQueue.plist" \
         "$DL/VolumeManagerAudioQueue.dylib.vmaq-backup" \
         "$DL/VolumeManagerAudioQueue.plist.vmaq-backup" \
         "$DL/VolumeManagerAudioQueue.dylib.vmaq-off" \
         "$DL/VolumeManagerAudioQueue.plist.vmaq-off" ; do
    if [ -e "$f" ]; then
        if mv -f "$f" "$GRAVEYARD/" 2>/dev/null; then
            echo "  已移出加载路径：$(basename "$f")"
        else
            echo "  警告 — 无法移动 $(basename "$f")，它会继续被加载（可能出杂音）！"
        fi
    fi
done

# ── v2.0.0：清退原版闭源栈中被自研替代的组件（升级路径） ─────────────────
#   旧面板 VolumeManagerPrefs.bundle + 旧 PreferenceLoader entry
#     （自研 VolManPrefsPanel 替代——「旧面板解绑」= 这一步生效，respring 后双入口变单入口）
#   原版主模块 VolumeManager.dylib（混音层已并入本包引擎 VolManAudioQueue）
#   净化模块 VolManPrefsClean（依附旧面板；面板退役即退役）
echo "VolManAudioQueue Full: 清退原版闭源旧组件…"
for f in "$JB/Library/PreferenceBundles/VolumeManagerPrefs.bundle"          "$JB/Library/PreferenceLoader/Preferences/VolumeManagerPrefs.plist"          "$DL/VolumeManager.dylib" "$DL/VolumeManager.plist"          "$DL/VolManPrefsClean.dylib" "$DL/VolManPrefsClean.plist" ; do
    if [ -e "$f" ]; then
        if rm -rf "$f" 2>/dev/null; then
            echo "  已清退：$(basename "$f")"
        else
            echo "  警告 — 清退失败（保留，可手动删）：$f"
        fi
    fi
done

# ── 配置：创建/修正真实目录 + 同步兜底副本 ──────────────────────────────
SRC=""
for c in "$DIR_JB/volumeInfo.plist" \
         "$DIR_PLAIN/volumeInfo.plist" \
         "$DIR_JBROOT/volumeInfo.plist" \
         /var/mobile/Library/Preferences/volumeInfo.plist ; do
    if [ -f "$c" ]; then SRC="$c"; break; fi
done

if [ -n "$SRC" ]; then
    # v1.3.0：把找到的配置回填到 jbroot 真实数据目录 —— 沙盒 App 只能读这里。
    # 只同步到 Preferences 副本的话，滞留在裸路径等其他位置的配置对音频 App
    # 完全不可见（2026-11-04 排障实录：配置滞留裸路径 → 全部音频 App
    # 「配置缺失」不装挂钩 → 中央日志也不再生成）。
    if [ "$SRC" != "$DIR_JB/volumeInfo.plist" ]; then
        if cp -f "$SRC" "$DIR_JB/volumeInfo.plist" 2>/dev/null; then
            chmod 666 "$DIR_JB/volumeInfo.plist" 2>/dev/null
            echo "  已回填 jbroot 数据目录 → $DIR_JB/volumeInfo.plist"
        else
            echo "  警告 — 无法回填 $DIR_JB/volumeInfo.plist（沙盒 App 将读不到配置）"
        fi
    fi
    cp -f "$SRC" "$SYNCED" 2>/dev/null
    chown mobile:mobile "$SYNCED" 2>/dev/null
    chmod 644 "$SYNCED" 2>/dev/null
    echo "配置已找到 → $SRC"
    echo "  已同步副本 → $SYNCED"
else
    echo "提示 — 尚未找到 volumeInfo.plist（全新安装时正常）。"
    echo "        打开一次「设置 → VolumeManager」随便改一个 App 的音量即可生成，"
    echo "        期望位置：$DIR_JB/volumeInfo.plist"
fi

# ── 白名单（v2.0）：同步兜底副本（沙箱 App 读不到 jbroot 数据目录） ──────
# 引擎查找顺序 = 三数据目录 → 本副本；文件缺失时引擎按兼容模式运行（v1.3.4 行为）。
WL_SYNCED=/var/mobile/Library/Preferences/com.local.volmanaudioqueue.appwhitelist.plist
WL_SRC=""
for c in "$DIR_JB/appwhitelist.plist" \
         "$DIR_PLAIN/appwhitelist.plist" \
         "$DIR_JBROOT/appwhitelist.plist" ; do
    if [ -f "$c" ]; then WL_SRC="$c"; break; fi
done
if [ -n "$WL_SRC" ]; then
    cp -f "$WL_SRC" "$WL_SYNCED" 2>/dev/null
    chown mobile:mobile "$WL_SYNCED" 2>/dev/null
    chmod 644 "$WL_SYNCED" 2>/dev/null
    echo "白名单已找到 → $WL_SRC"
    echo "  已同步副本 → $WL_SYNCED"
else
    echo "提示 — 尚无 appwhitelist.plist（白名单未初始化，引擎按兼容模式运行）。"
fi

# ── 调试旁路样例（默认不启用） ──────────────────────────────────────────
S="$DIR_JB/vmaq-force.txt.sample"
if [ ! -f "$S" ]; then
    printf '0.3\n' > "$S" 2>/dev/null
    chmod 666 "$S" 2>/dev/null
fi

# ── 清理「同名但少个 /jb」的旧目录 ──────────────────────────────────────
#     这两个路径**是两个不同的目录**，但在 Filza 里看着几乎一样，极易混淆
#     （v0.4.0 时代到处写日志，在裸路径留下了这个空壳）。
#     只删我们自己写的 vmaq.log；目录里若还有别的东西一律不动。
if [ -d "$DIR_PLAIN" ]; then
    if [ ! -f "$DIR_PLAIN/volumeInfo.plist" ]; then
        if [ -f "$DIR_PLAIN/vmaq.log" ]; then
            rm -f "$DIR_PLAIN/vmaq.log" 2>/dev/null && \
                echo "已清理过期日志 $DIR_PLAIN/vmaq.log"
        fi
        if rmdir "$DIR_PLAIN" 2>/dev/null; then
            echo "已移除同名空目录 $DIR_PLAIN"
            echo "  （它和 $DIR_JB 其实是两个地方，后者才是真目录）"
        fi
    else
        echo "注意 — $DIR_PLAIN 里有 volumeInfo.plist，保留不动"
    fi
fi

# ── Orion 运行时自检（本包依赖 dev.theos.orion） ────────────────────────
ORION=/var/jb/Library/Frameworks/Orion.framework/Orion
if [ -f "$ORION" ]; then
    echo "Orion 运行时：已就绪（$ORION）"
else
    echo ""
    echo "!! 未检测到 Orion 运行时：$ORION"
    echo "   本包带的 HUD / 设置面板是 Swift + Orion 编译的，缺少它会在 respring 后不显示。"
    echo "   请用 Sileo 安装依赖 dev.theos.orion（在 Theos 官方源里），"
    echo "   或手动安装 Orion Runtime 的 deb 后再 respring。"
fi

# ── 自动刷新「按 App 拷贝注入」的引擎副本（JailFools/TrollFools 注入形态） ──
# 这类 App 的引擎被冻结在 <App>.app/Frameworks/VolManAudioQueue.dylib，
# 升级 deb 不会跟随——此前每次升级都要手动覆盖（2026-11-04 SOP 的三步法）。
# v1.3.2 起安装时自动完成覆盖：把中央新引擎刷到所有现存副本。
# 纪律：只刷新已存在的副本（判定依据=精确文件名），绝不新注入；
#       .jailfools 记录一律不动；临时文件+rename 原子替换，
#       正在运行的 App 不受影响，重启 App 后生效。
CENTRAL_DYLIB="$DL/VolManAudioQueue.dylib"
if [ -f "$CENTRAL_DYLIB" ]; then
    REFRESH_LIST=$(find /var/containers/Bundle/Application -maxdepth 6 \
        -name '.jbroot-*' -prune -o \
        -type f -path '*/Frameworks/VolManAudioQueue.dylib' -print 2>/dev/null)
    if [ -n "$REFRESH_LIST" ]; then
        echo "VolManAudioQueue Full: 自动刷新拷贝注入副本…"
        echo "$REFRESH_LIST" | while IFS= read -r dst; do
            [ -n "$dst" ] || continue
            if cp -f "$CENTRAL_DYLIB" "$dst.new" 2>/dev/null \
               && chmod 755 "$dst.new" 2>/dev/null \
               && mv -f "$dst.new" "$dst" 2>/dev/null; then
                chown mobile:mobile "$dst" 2>/dev/null
                echo "  已刷新 → $dst"
            else
                echo "  警告 — 刷新失败（旧副本保留，可按 SOP 手动覆盖）：$dst"
            fi
        done
    else
        echo "VolManAudioQueue Full: 未发现拷贝注入副本（无需刷新）。"
    fi
else
    echo "VolManAudioQueue Full: 警告 — 中央引擎缺失（$CENTRAL_DYLIB），跳过副本刷新。"
fi

echo ""
echo "VolManAudioQueue Full 2.0.2: 安装完成。请执行一次 respring（注销）使改动生效。"
echo "  日志文件：$DIR_JB/vmaq.log"
echo "  拷贝注入的 App：重启 App 后生效（验收=容器日志头 === v2.0.0 注入）。"
exit 0
